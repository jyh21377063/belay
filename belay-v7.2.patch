+    starts = [m.start() for m in re.finditer(r"\{", text)][:300]
+    for s in starts:
+        for fix in (False, True):
+            src = _fix_escapes(text[s:]) if fix else text[s:]
+            try:
+                v, _ = dec.raw_decode(src)
